{% sw_extends '@Storefront/storefront/utilities/offcanvas.html.twig' %}

{% block utilities_offcanvas_content %}
    {% block component_product_documents_container %}
        <div class="product-detail-documents tab-pane-container">
            {% block component_product_documents_title %}
                <h2 class="product-detail-documents-title">
                    {{ 'detail.documentsTitle'|trans|sw_sanitize }}
                </h2>
            {% endblock %}

            {% block component_product_documents_list %}
                <ul class="product-detail-documents-list list-unstyled">
                    {% for document in documents %}
                        {% set media = documentMedia.get(document.translated.mediaId) %}
                        {% set opensInNewTab = media.mimeType == 'application/pdf' or media.mimeType starts with 'image/' %}

                        {% block component_product_documents_item %}
                            <li class="product-detail-documents-item">
                                {% block component_product_documents_item_icon %}
                                    {% sw_icon 'file' style { size: 'sm' } %}
                                {% endblock %}

                                {% block component_product_documents_item_link %}
                                    <a href="{{ media.url }}"
                                       class="product-detail-documents-link"
                                       {% if opensInNewTab %}
                                       target="_blank"
                                       rel="noopener"
                                       {% else %}
                                       download
                                       {% endif %}>
                                        {% block component_product_documents_item_name %}
                                            <span class="product-detail-documents-name">{{ document.translated.title ?: media.fileName }}</span>
                                        {% endblock %}

                                        {% block component_product_documents_item_file_info %}
                                            {% set fileInfo = [] %}

                                            {% if media.fileExtension %}
                                                {% set fileInfo = fileInfo|merge([media.fileExtension|upper]) %}
                                            {% endif %}

                                            {% if media.fileSize %}
                                                {% set fileSize = media.fileSize %}

                                                {# Moves up a unit from 0.9 of it on, like the file sizes in the Administration #}
                                                {% if fileSize >= 0.9 * 1024 * 1024 %}
                                                    {% set fileInfo = fileInfo|merge([(fileSize / (1024 * 1024))|format_number({ fraction_digit: 1 }, locale=app.request.locale) ~ ' MB']) %}
                                                {% elseif fileSize >= 0.9 * 1024 %}
                                                    {% set fileInfo = fileInfo|merge([(fileSize / 1024)|format_number({ fraction_digit: 0 }, locale=app.request.locale) ~ ' KB']) %}
                                                {% else %}
                                                    {% set fileInfo = fileInfo|merge([fileSize ~ ' B']) %}
                                                {% endif %}
                                            {% endif %}

                                            {% if fileInfo is not empty %}
                                                <span class="product-detail-documents-file-info">({{ fileInfo|join(', ') }})</span>
                                            {% endif %}
                                        {% endblock %}

                                        {% block component_product_documents_item_new_tab_hint %}
                                            {% if opensInNewTab %}
                                                <span class="visually-hidden">{{ 'detail.documentsOpensInNewTab'|trans|sw_sanitize }}</span>
                                            {% endif %}
                                        {% endblock %}
                                    </a>
                                {% endblock %}
                            </li>
                        {% endblock %}
                    {% endfor %}
                </ul>
            {% endblock %}
        </div>
    {% endblock %}
{% endblock %}
